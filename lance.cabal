cabal-version:   3.4
name:            lance
version:         0.1.0.0
license:         MIT
license-file:    LICENSE
author:          bytemuck
maintainer:      bytemuck@gmail.com
category:        Language
build-type:      Simple
extra-doc-files: CHANGELOG.md

common warnings
  ghc-options: -Wall

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
    Lance.Evaluate.Env
    Lance.Evaluate.Evaluate
    Lance.Resolve.Resolve
    Lance.Resolve.ResolvedExpr
    Lance.Tokenize.Lex
    Lance.Tokenize.Primitive
    Lance.Tokenize.Text
    Lance.Tokenize.Tokenize
    Lance.Tokenize.TokenizedExpr

  default-language: GHC2024
  build-depends:
    , base           ^>=4.21.0.0
    , containers     ^>=0.8
    , mtl            ^>=2.3.0.0
    , pretty-simple  ^>=4.1.3.0

executable lance
  import:           warnings
  hs-source-dirs:   app
  main-is:          Main.hs
  default-language: GHC2024
  build-depends:
    , base           ^>=4.21.0.0
    , containers     ^>=0.8
    , lance
    , mtl            ^>=2.3.0.0
    , pretty-simple  ^>=4.1.3.0

test-suite lance-test
  import:           warnings
  hs-source-dirs:   test
  main-is:          Main.hs
  type:             exitcode-stdio-1.0
  default-language: GHC2024
  build-depends:
    , base   ^>=4.21.0.0
    , hspec  ^>=2.11.0.0
    , lance
